APP_NAME=JobPortal
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=jobportal_v2
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Chat real time. `log` keeps chat on plain REST (clients poll). To go real time: BROADCAST_CONNECTION=reverb, generate the three
# REVERB_APP_* values yourself (random strings, never committed), run `php artisan reverb:start` under a process manager and proxy the
# WebSocket path through the web server. REVERB_HOST/PORT/SCHEME are how this app reaches Reverb (to publish events and ask who is online).
BROADCAST_CONNECTION=log
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=443
REVERB_SCHEME=https
# Comma separated origins of the client apps allowed to connect.
REVERB_ALLOWED_ORIGINS=
FILESYSTEM_DISK=local
# Production uses the database driver (tables `jobs` and `failed_jobs`) with workers started for the queues
# `critical,default,bulk` (in this order). Use `sync` only for local development: it runs jobs inside the request.
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Production must use a real mailer (smtp). `log` writes every email, including verification codes, to the application log:
# use it only for local development.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Google sign-in: the OAuth client IDs (web, Android, iOS) whose ID tokens are accepted, comma separated. Empty turns it off.
GOOGLE_CLIENT_IDS=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Client page that accepts a company invitation; {token} is replaced. Empty = invitations cannot be created.
COMPANY_INVITATION_URL=
