# Copy to janus.env (chmod 600). Values marked "same as" must equal the application's .env.

# `id -u jobportal` and `id -g jobportal`
APP_UID=54336
APP_GID=54341
# The directory on the host that both Janus and the application see. The application's JANUS_RECORDINGS_PATH is this path;
# JANUS_RECORDINGS_DIR (what the application sends to the converter) is /recordings.
RECORDINGS_HOST_DIR=/var/lib/jobportal/janus-recordings

# The public IPv4 address of the server (Janus advertises it in ICE candidates).
JANUS_PUBLIC_IP=
# Same as the application's JANUS_ADMIN_SECRET and JANUS_API_TOKEN (random strings, at least 32 characters).
JANUS_ADMIN_SECRET=
JANUS_API_TOKEN=
# Same as the application's JANUS_WEBHOOK_SECRET.
JANUS_WEBHOOK_SECRET=
# Where the application's nginx accepts the webhooks (the loopback-only server block in nginx/janus-internal.conf).
APP_WEBHOOK_BASE=http://127.0.0.1:18089/api/v1/internal/janus
# The STUN server Janus uses to learn its own candidates.
STUN_SERVER=stun.l.google.com
STUN_PORT=19302
# coturn: the realm (the API host name) and the shared secret, same as the application's TURN_SECRET.
TURN_REALM=api-karir.satu.solutions
TURN_SECRET=
