# Copy to asterisk.env (chmod 600; `setup.sh` does it and fills the secrets). Values marked "same as" must equal the application's .env.

# `id -u jobportal` and `id -g jobportal`
APP_UID=54336
APP_GID=54341
# The directory on the host where Asterisk writes the call recordings until the application fetches them (the container's /var/spool/asterisk/recording).
RECORDINGS_HOST_DIR=/var/lib/jobportal/asterisk-recordings

# The public IPv4 address of the server (advertised to the trunk and to the browsers' ICE).
ASTERISK_PUBLIC_IP=
STUN_SERVER=stun.l.google.com
STUN_PORT=19302

# The application's account on ARI. Same as ASTERISK_ARI_USER and ASTERISK_ARI_PASSWORD (a random string, at least 32 characters).
ARI_USER=jobportal
ARI_PASSWORD=

# The SIP trunk (from the provider's contract). TRUNK_HOST is the provider's SIP server, TRUNK_MATCH the address or network its calls come from (CIDR, e.g. 203.0.113.0/28).
TRUNK_HOST=
TRUNK_PORT=5060
TRUNK_MATCH=
# `register` when the provider wants the platform to register with a user name and password, `ip` when it recognises the server by its address.
TRUNK_AUTH=register
TRUNK_USERNAME=
TRUNK_PASSWORD=
